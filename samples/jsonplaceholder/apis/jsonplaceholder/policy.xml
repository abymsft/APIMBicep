<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="3" renewal-period="10" counter-key='@(context.Subscription.Id + "-burst")' />
    <set-backend-service backend-id="jsonplaceholder-backend" />
    <cache-lookup vary-by-developer="false" vary-by-developer-groups="false" downstream-caching-type="none" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <cache-store duration="{{jsonplaceholder-cache-seconds}}" />
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
